# Waitlist backend configuration (§8.3 of the landing page spec)
#
# The waitlist API route (app/api/waitlist/route.ts) persists submissions
# to a Supabase `waitlist` table over the REST API. Without these values,
# submissions return 503 `not_configured` and the form shows an error state
# (successful submissions are never faked).
#
# 1. Create a project at https://supabase.com
# 2. Run the SQL in the README ("Waitlist database setup") in the SQL editor
# 3. Copy the Project URL and either key from Project Settings → API
# 4. Fill in the values below and restart the dev server

SUPABASE_URL=""
# Preferred: service_role secret key (server-side only, full table access,
# works regardless of RLS policies).
SUPABASE_SERVICE_ROLE_KEY=""
# Alternative: public anon key — requires the RLS insert-only policy from
# the README (public can insert, but can never read the table).
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
